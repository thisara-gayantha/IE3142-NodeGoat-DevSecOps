# Copy this file to .env for local development.
# Never commit the real .env file.

NODE_ENV=development
PORT=4000

# MongoDB connection used by the Docker Compose web container.
MONGODB_URI=replace_with_your_mongodb_connection_uri

# Application secrets.
SESSION_SECRET=replace_with_a_long_random_value
CRYPTO_KEY=replace_with_a_long_random_value
ZAP_API_KEY=replace_with_a_new_zap_api_key

# Local NodeGoat demonstration account passwords.
# Store real values only in the ignored .env file.
NODEGOAT_ADMIN_PASSWORD=replace_with_a_private_admin_password
NODEGOAT_USER1_PASSWORD=replace_with_a_private_user1_password
NODEGOAT_USER2_PASSWORD=replace_with_a_private_user2_password